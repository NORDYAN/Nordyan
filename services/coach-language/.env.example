# OpenAI (server-only — never expose to the Expo client)
OPENAI_API_KEY=
OPENAI_COACH_MODEL=gpt-4o-mini

# HTTP (8788 avoids tools/coach-simulator on 8787)
COACH_SERVER_PORT=8788

# Supabase JWT verification (Authorization: Bearer <access_token>)
SUPABASE_URL=
# Prefer SUPABASE_ANON_KEY; SUPABASE_PUBLISHABLE_KEY is also accepted
SUPABASE_ANON_KEY=

# Optional
# OPENAI_COACH_TIMEOUT_MS=15000
# NODE_ENV=production
# Comma-separated origins, or * / unset for local Expo development
# COACH_CORS_ORIGINS=*

# Data control note:
# Requests use store: false so outputs are not intentionally retained as OpenAI
# product history. store: false is NOT the same as Zero Data Retention (ZDR).
# Review organizational OpenAI data-control / retention settings separately.

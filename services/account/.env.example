# Server-only. Never copy these into Expo or EXPO_PUBLIC_*.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Prefer SUPABASE_ANON_KEY; SUPABASE_PUBLISHABLE_KEY is also accepted
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Listen port (Fly maps http_service.internal_port to this)
ACCOUNT_SERVER_PORT=8789

# Optional comma list; unset or * allows local Expo origins
# ACCOUNT_CORS_ORIGINS=

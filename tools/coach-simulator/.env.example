# Coach simulator server — copy to .env and fill in locally. Never commit secrets.

# Required for OpenAI mode (server-side only)
OPENAI_API_KEY=

# Optional — defaults to gpt-4o-mini
OPENAI_COACH_MODEL=gpt-4o-mini

# Optional — defaults to 8787
COACH_SERVER_PORT=8787

# Optional — OpenAI request timeout in ms (default 15000)
OPENAI_COACH_TIMEOUT_MS=15000

# Do NOT use VITE_OPENAI_API_KEY — API keys must never reach the browser bundle.

# Data control: see DATA_CONTROL.md
# store:false does not alone guarantee Zero Data Retention.
# Review platform retention and organisational data controls before production health-data use.
# Simulator scenarios must remain synthetic.

# Public Supabase client credentials (safe to expose in the mobile app bundle).
# Never put service_role or other secret keys here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the publishable key from Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Legacy fallback if your project only shows the anon public key:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# MVP development only:
# - Disable "Confirm email" under Authentication → Providers → Email.
# Before production:
# - Re-enable email confirmation in Supabase.
# - Implement deep linking / confirmation email handling in the app.

# Database migrations (required for health snapshots / Progress card):
# 1. Install Supabase CLI: npm install
# 2. Link project: npx supabase link --project-ref YOUR_PROJECT_REF
# 3. Apply migrations: npm run db:push
# Or run the SQL files in supabase/migrations/ via Supabase Dashboard → SQL Editor.

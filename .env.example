# Public Supabase client credentials (safe to expose in the mobile app bundle).
# Never put service_role or other secret keys here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the publishable key from Supabase Dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Legacy fallback if your project only shows the anon public key:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# MVP development only:
# - Disable "Confirm email" under Authentication → Providers → Email.
# Before production:
# - Re-enable email confirmation in Supabase.
# - Implement deep linking / confirmation email handling in the app.

# Database migrations (required for health snapshots / Progress card):
# 1. Install Supabase CLI: npm install
# 2. Link project: npx supabase link --project-ref YOUR_PROJECT_REF
# 3. Apply migrations: npm run db:push
# Or run the SQL files in supabase/migrations/ via Supabase Dashboard → SQL Editor.

# Production coach language bridge (optional). URL only — never put OpenAI secrets here.
# Home works fully with this unset (Swedish production templates).
#
# Local service: npm run coach-language  (binds 0.0.0.0:8788)
#
# Expo Go on a PHYSICAL phone — do NOT use localhost (the phone cannot reach your PC that way):
#   1. Phone and PC on the same Wi‑Fi
#   2. ipconfig (Windows) / ifconfig (macOS) → note IPv4, e.g. 192.168.1.154
#   3. Allow inbound TCP 8788 in the Windows firewall if needed
#   4. Set the URL below to http://<LAN-IP>:8788  then restart Expo
#   5. On the phone browser (optional), open http://<LAN-IP>:8788/health
#
# Emulator/simulator on the same machine may use http://localhost:8788
# Never set: OPENAI_API_KEY, OPENAI_COACH_MODEL (those stay in services/coach-language/.env)
# EXPO_PUBLIC_COACH_LANGUAGE_API_URL=http://192.168.1.154:8788
